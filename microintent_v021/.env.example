# auto = use Gemini when GEMINI_API_KEY is present; otherwise conservative deterministic fallback
# gemini = require Gemini, falling back safely if the API call fails
# deterministic = local rule scorer only
MICROINTENT_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 1 = public demo: always use the deterministic extractor, even if a key is set
MICROINTENT_DEMO=0
